# Copy to .env and fill in. NEVER commit .env

# ===== Choose ONE: gemini | claude | openai | mock =====
LLM_PROVIDER=gemini

# Gemini (free tier) - https://aistudio.google.com/apikey
# Note: free-tier prompts may be used by Google to improve products. Synthetic data only.
GEMINI_API_KEY=

# Claude (paid, separate from Claude Pro) - https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI (paid, separate from ChatGPT Plus) - https://platform.openai.com
OPENAI_API_KEY=

# Optional model overrides (defaults are in llm.py)
# GEMINI_MODEL=gemini-3.8-flash
# CLAUDE_MODEL=claude-haiku-5-5
# OPENAI_MODEL=gpt-4o-mini
